# ── App ──────────────────────────────────────────────────────────────
APP_NAME=Robo-Promo
DEBUG=false
SECRET_KEY=troque-por-uma-chave-segura

# Login do painel (/admin). Vazio = sem login (só para uso local).
# O deploy/setup.sh gera uma senha automaticamente no servidor.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Front hospedado fora do robô (ex.: Vercel) que pode usar a API. Vírgula separa vários.
DASHBOARD_ALLOWED_ORIGINS=

# ── Banco de dados ────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./robopromo.db

# ── Mercado Livre (obrigatório) ───────────────────────────────────────
# Acesse: https://developers.mercadolivre.com.br/
ML_APP_ID=SEU_APP_ID
ML_SECRET_KEY=SEU_SECRET_KEY
ML_ACCESS_TOKEN=SEU_ACCESS_TOKEN
# Gere com: python get_token.py (necessário para renovação automática 24/7)
ML_REFRESH_TOKEN=

# ── Afiliados ML ──────────────────────────────────────────────────────
# Acesse: https://afiliados.mercadolivre.com.br/
ML_AFFILIATE_ID=SEU_PUBLISHER_ID
ML_AFFILIATE_TAG=robopromo

# ── Shopee Affiliate (Open API GraphQL) ────────────────────────────────
# Cadastre-se em: https://affiliate.shopee.com.br/open_api/home
SHOPEE_APP_ID=SEU_APP_ID
SHOPEE_SECRET_KEY=SEU_SECRET_KEY

# ── WhatsApp (bridge Baileys local, compatível com API Evolution) ─────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-esta-chave
EVOLUTION_INSTANCE=robopromo

# ── Canais destino (JSON array) ───────────────────────────────────────
# type: group | community | channel
WHATSAPP_CHANNELS=[{"id":"120363XXXXXXXXXX@g.us","type":"group"}]

# ── Filtros ───────────────────────────────────────────────────────────
MIN_DISCOUNT_PERCENT=30
MIN_SAVINGS_BRL=50
MIN_RATING=3.5
REQUIRE_COUPON=false

# ── Anti-spam ─────────────────────────────────────────────────────────
REPOST_COOLDOWN_HOURS=24
SIGNIFICANT_PRICE_DROP_PCT=10

# ── Scheduler ────────────────────────────────────────────────────────
SCRAPER_INTERVAL_SECONDS=300
SCRAPER_CONCURRENCY=10
MAX_PROMOTIONS_PER_CYCLE=15
